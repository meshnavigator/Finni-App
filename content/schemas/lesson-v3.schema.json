{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://finni.local/schema/lesson-v3.schema.json",
  "title":"Finni lesson schema v3",
  "type":"object",
  "additionalProperties":false,
  "required":["schemaVersion","id","title","contentVersion","topic","format","level","observableAction","explanation","unlockPeriod","competencyIds","sourceRefs","defaultVariantId","returnTarget","mechanic","mode","rendererId","variants"],
  "properties":{
    "schemaVersion":{"const":3},
    "id":{"type":"string","pattern":"^LS-[BPS][0-9]{2}$"},
    "title":{"$ref":"#/$defs/text"},
    "contentVersion":{"const":"1.2.0"},
    "topic":{"enum":["budget","purchases","savings"]},
    "format":{"enum":["standard","detective","workshop"]},
    "level":{"type":"integer","minimum":1,"maximum":3},
    "observableAction":{"$ref":"#/$defs/text"},
    "explanation":{"$ref":"#/$defs/text"},
    "unlockPeriod":{"type":"integer","minimum":1,"maximum":5},
    "competencyIds":{"type":"array","minItems":1,"maxItems":10,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}},
    "sourceRefs":{"type":"array","minItems":1,"maxItems":10,"items":{"$ref":"#/$defs/text"}},
    "defaultVariantId":{"$ref":"#/$defs/id"},
    "returnTarget":{"enum":["home","shop","budget","history","savings"]},
    "mechanic":{"enum":["allocation","basket","savings","receipt_audit","resource_choice"]},
    "mode":{"enum":["basic","changed_need","shopping_list","compare_offers","schedule","withdrawal_preview","duplicate_line","make_or_buy"]},
    "rendererId":{"enum":["allocation","basket","savings","receipt_audit","resource_choice"]},
    "variants":{"type":"array","minItems":1,"maxItems":12,"items":{"$ref":"#/$defs/variant"}}
  },
  "$defs":{
    "id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "text":{"type":"string","minLength":1,"maxLength":600},
    "amount":{"type":"integer","minimum":0,"maximum":1000000000},
    "copy":{"type":"object","additionalProperties":false,"required":["intro","hints","feedback"],"properties":{"intro":{"$ref":"#/$defs/text"},"hints":{"type":"array","minItems":2,"maxItems":2,"items":{"$ref":"#/$defs/text"}},"feedback":{"type":"object","additionalProperties":false,"required":["meets_goal","valid_alternative","needs_review","invalid_input"],"properties":{"meets_goal":{"$ref":"#/$defs/text"},"valid_alternative":{"$ref":"#/$defs/text"},"needs_review":{"$ref":"#/$defs/text"},"invalid_input":{"$ref":"#/$defs/text"}}}}},
    "evidence":{"type":"object","additionalProperties":false,"required":["id","text"],"properties":{"id":{"$ref":"#/$defs/id"},"text":{"$ref":"#/$defs/text"},"assetId":{"$ref":"#/$defs/id"}}},
    "fixture":{"type":"object","additionalProperties":false,"required":["solution","expectedOutcome"],"properties":{"solution":{},"expectedOutcome":{"enum":["meets_goal","valid_alternative","needs_review","invalid_input"]}}},
    "variant":{"type":"object","additionalProperties":false,"required":["id","params","copy","evidence","fixtures"],"properties":{"id":{"$ref":"#/$defs/id"},"params":{"type":"object"},"copy":{"$ref":"#/$defs/copy"},"evidence":{"type":"array","maxItems":20,"items":{"$ref":"#/$defs/evidence"}},"fixtures":{"type":"array","minItems":2,"maxItems":30,"items":{"$ref":"#/$defs/fixture"}}}}
  }
}
