          disabled={props.disabled}
          onPress={props.onPress}
          style={[styles.choice, props.selected && styles.choiceSelected, props.disabled && styles.disabled]}
        >
          <Text style={styles.choiceText}>{props.selected ? '✓ ' : ''}{props.label}</Text>
        </Pressable>
      );
    }
    
