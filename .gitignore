# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*
__pycache__/
*.pyc

# macOS
.DS_Store
*.pem

# local env files and release-signing material
.env
.env.*
!.env.example
*.keystore

# typescript
*.tsbuildinfo

# Local belief-map generated artifacts
.belief_map.sexp
.belief_map_cache.json

# iOS remains generated. Android is intentionally tracked after the initial prebuild.
/ios

# Android build outputs
/android/.gradle
/android/build
/android/app/build
/android/local.properties

# Submission APK is kept locally and attached to the delivery separately.
/artifacts/release/*.apk
