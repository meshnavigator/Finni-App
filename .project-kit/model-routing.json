{
  "schema_version": 1,
  "default_mode": "adaptive",
  "aliases": {
    "astra": "gpt-6-astra",
    "sol": "gpt-6-sol",
    "luna": "gpt-6-luna",
    "uno": "gpt-6-luna"
  },
  "direct": {
    "prefix": "DIRECT",
    "single_executor": true,
    "bypass_adaptive": true,
    "automatic_escalation": false,
    "cross_model_review": false,
    "fallback_model": null,
    "default_reasoning": {
      "gpt-6-astra": "high",
      "gpt-6-sol": "high",
      "gpt-6-luna": "high"
    }
  },
  "solo": {
    "preserve_current_model": true,
    "preserve_current_reasoning": true,
    "delegation": false
  },
  "astra_approval": {
    "required_before_routing_or_dispatch": true,
    "direct_request_counts_as_approval": false,
    "manual_primary_task_selection_counts_as_approval": true,
    "approval_scope": "current_task_or_package_only",
    "on_direct_decline": "stop_without_fallback",
    "on_adaptive_decline": {
      "model": "gpt-6-sol",
      "reasoning": "high"
    }
  },
  "adaptive": {
    "default_profile": "balanced",
    "profiles": {
      "fast": {
        "prefer": ["gpt-6-luna", "gpt-6-sol"],
        "review": "orchestrator",
        "max_escalations_per_package": 0
      },
      "balanced": {
        "prefer": ["gpt-6-sol", "gpt-6-luna"],
        "review": "orchestrator",
        "max_escalations_per_package": 1
      },
      "deep": {
        "prefer": ["gpt-6-sol", "gpt-6-astra"],
        "review": "independent_for_high_risk",
        "max_escalations_per_package": 1
      }
    },
    "routes": {
      "mechanical_low_risk": {
        "model": "gpt-6-luna",
        "reasoning": "high"
      },
      "standard_implementation": {
        "model": "gpt-6-sol",
        "reasoning": "medium"
      },
      "architecture_and_integration": {
        "model": "gpt-6-sol",
        "reasoning": "high"
      },
      "complex_architecture_or_review": {
        "model": "gpt-6-sol",
        "reasoning": "xhigh"
      },
      "highest_risk_or_ambiguity": {
        "model": "gpt-6-astra",
        "reasoning": "high"
      }
    },
    "limits": {
      "same_model_correction_attempts": 1,
      "parallel_writers_per_worktree": 1
    }
  },
  "codex_desktop_reasoning": {
    "gpt-6-astra": ["low", "medium", "high", "xhigh", "max", "ultra"],
    "gpt-6-sol": ["none", "low", "medium", "high", "xhigh", "max", "ultra"],
    "gpt-6-luna": ["none", "low", "medium", "high", "xhigh", "max"]
  }
}
