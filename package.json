{
  "name": "finni",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "expo": "~57.0.23",
    "expo-build-properties": "~57.0.20",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.12",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:core": "node --test tests/domain.test.mjs tests/domain-overflow.test.mjs tests/domain-five-period.test.mjs tests/budget-plan.test.mjs tests/commerce.test.mjs tests/savings-commerce.test.mjs tests/period-close.test.mjs tests/persistence.test.mjs tests/lifecycle.test.mjs tests/lifecycle-coordinator.test.mjs tests/adult-history-control.test.mjs tests/core-regression.test.mjs",
    "content": "node scripts/check-content.mjs && node scripts/validate-content.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "fixtures": "node scripts/check-fixtures.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run content && npm run fixtures",
    "android:prebuild": "expo prebuild --platform android --clean --no-install",
    "android:release": "pwsh -NoProfile -File ./scripts/build-release.ps1"
  },
  "private": true,
  "engines": {
    "node": "22.18.0",
    "npm": "10.9.3"
  },
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  }
}
